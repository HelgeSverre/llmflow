# LLMFlow Environment Variables
# Copy this file to .env and uncomment or fill in what you need.
# Every value shown is the default; commented lines leave the default in place.
# .env files are not shell-expanded: write absolute paths, never ~ or $HOME.

# ===========================================
# Servers
# ===========================================

# Proxy port (receives LLM API requests)
# PROXY_PORT=8080

# Dashboard, REST API and OTLP ingestion port
# DASHBOARD_PORT=1337

# Interface the proxy binds to (use 0.0.0.0 to accept remote clients)
# PROXY_HOST=127.0.0.1

# Interface the dashboard binds to (use 0.0.0.0 to accept remote clients)
# DASHBOARD_HOST=127.0.0.1

# Extra origins allowed to open the dashboard WebSocket (comma-separated)
# WS_ALLOWED_ORIGINS=https://llmflow.example.com

# Milliseconds before a proxied upstream request is aborted
# PROXY_TIMEOUT_MS=300000

# Log every request, not only a compact summary line (0=off, 1=on)
# VERBOSE=0

# ===========================================
# Storage
# ===========================================

# Directory for the SQLite database (default: .llmflow in your home directory)
# DATA_DIR=/home/you/.llmflow

# Full path to the SQLite file (default: $DATA_DIR/data.db)
# DB_PATH=/home/you/.llmflow/data.db

# Traces to keep; the oldest are pruned beyond this
# MAX_TRACES=10000

# Log records to keep; the oldest are pruned beyond this
# MAX_LOGS=100000

# Metric points to keep; the oldest are pruned beyond this
# MAX_METRICS=1000000

# URL of the model pricing JSON used for cost estimates
# PRICING_URL=https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json

# ===========================================
# Provider API Keys
# ===========================================
# Proxied requests use the key the client sends. The server reads these only
# for the dashboard's provider health check and for replaying a trace.

# OpenAI
OPENAI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Google Gemini (either name works; GOOGLE_API_KEY wins if both are set)
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Cohere (replay only)
COHERE_API_KEY=

# Groq
GROQ_API_KEY=

# Mistral AI (replay only)
MISTRAL_API_KEY=

# Together AI (replay only)
TOGETHER_API_KEY=

# Perplexity (replay only)
PERPLEXITY_API_KEY=

# OpenRouter (replay only)
OPENROUTER_API_KEY=

# ===========================================
# Provider-Specific Settings
# ===========================================

# Ollama host and port (local LLM server)
# OLLAMA_HOST=localhost
# OLLAMA_PORT=11434

# Azure OpenAI resource name, key (replay only) and API version
# AZURE_OPENAI_RESOURCE=your-resource-name
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-02-01
# Map a model to a deployment: AZURE_DEPLOYMENT_<MODEL, with . and - as _, uppercased>
# AZURE_DEPLOYMENT_GPT_4=gpt-4-deployment
# AZURE_DEPLOYMENT_GPT_35_TURBO=gpt-35-turbo-deployment

# Helicone gateway host, port and fallback key (a helicone-auth header wins)
# HELICONE_HOST=oai.helicone.ai
# HELICONE_PORT=443
# HELICONE_API_KEY=

# ===========================================
# OTLP Export Settings
# ===========================================
# Export traces/logs/metrics to external observability backends
# Supports: Jaeger, Phoenix/Arize, Langfuse, Opik, Grafana Tempo, etc.

# Enable OTLP export (auto-enabled if any endpoint is set)
# OTLP_EXPORT_ENABLED=true

# Traces endpoint, used when OTLP_EXPORT_TRACES_ENDPOINT is unset (traces only)
# OTLP_EXPORT_ENDPOINT=http://localhost:4318/v1/traces

# Signal-specific endpoints (logs and metrics are exported only when set here)
# OTLP_EXPORT_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTLP_EXPORT_LOGS_ENDPOINT=http://localhost:4318/v1/logs
# OTLP_EXPORT_METRICS_ENDPOINT=http://localhost:4318/v1/metrics

# Export headers (comma-separated key=value pairs)
# Examples:
# Jaeger: (no auth needed for local)
# Langfuse: Authorization=Basic base64(pk:sk)
# Phoenix: space_id=xxx,api_key=xxx
# Opik: Authorization=your-api-key,projectName=your-project
# OTLP_EXPORT_HEADERS=Authorization=Bearer xxx,X-Custom-Header=value

# Records per export batch (per signal), and milliseconds between flushes
# OTLP_EXPORT_BATCH_SIZE=100
# OTLP_EXPORT_FLUSH_INTERVAL=5000

# Also emit the deprecated v1.36.0 GenAI attribute names (0=off, 1=on)
# LLMFLOW_OTLP_LEGACY_ATTRS=0

# ===========================================
# Development (bun run dev and the CLI helpers)
# ===========================================

# Backend URL the dashboard dev server and `bun run demo` target
# (default: discovered from the running dev backend)
# LLMFLOW_URL=http://127.0.0.1:1337

# Where dev runtimes record their URLs (default: a per-checkout temp directory)
# LLMFLOW_DEV_STATE_DIR=/tmp/llmflow-dev

# Vite dashboard dev server port and bind interface
# VITE_PORT=5173
# VITE_HOST=127.0.0.1
