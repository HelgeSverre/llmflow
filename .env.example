# LLMFlow environment variables
# Generated from packages/shared/src/config.ts by `bun run env:docs`; edit that list, not this block.
# Copy this file to .env and uncomment or fill in what you need. Commented values are the
# defaults, or examples where the default is computed.
# .env files are not shell-expanded: write absolute paths, never ~ or $HOME.

# ===========================================
# Servers
# ===========================================

# Proxy port (receives LLM API requests); 0 picks a free port
# PROXY_PORT=8080

# Dashboard, JSON API and OTLP receiver port; 0 picks a free port
# DASHBOARD_PORT=1337

# Interface the proxy binds to (0.0.0.0 accepts remote clients)
# PROXY_HOST=127.0.0.1

# Interface the dashboard binds to (0.0.0.0 accepts remote clients)
# DASHBOARD_HOST=127.0.0.1

# Extra origins allowed to open the dashboard WebSocket (comma-separated)
# WS_ALLOWED_ORIGINS=https://llmflow.example.com

# Milliseconds before a proxied upstream request is aborted
# PROXY_TIMEOUT_MS=300000

# Log debug detail (1=on); the --verbose flag does the same
# VERBOSE=0

# ===========================================
# Storage
# ===========================================

# Directory for the SQLite database (default: ~/.llmflow)
# DATA_DIR=/home/you/.llmflow

# Full path to the SQLite file (default: $DATA_DIR/data.db)
# DB_PATH=/home/you/.llmflow/data.db

# Spans to keep; whole traces are pruned oldest first beyond this
# MAX_SPANS=10000

# Former name of MAX_SPANS, read when MAX_SPANS is unset
# MAX_TRACES=

# Log records to keep; the oldest are pruned beyond this
# MAX_LOGS=100000

# Metric points to keep; the oldest are pruned beyond this
# MAX_METRICS=1000000

# Model pricing JSON used for cost estimates
# PRICING_URL=https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json

# ===========================================
# Provider API keys
# ===========================================
# Proxied requests use the key the client sends. The server reads these only
# to replay a captured request from the dashboard.

# OpenAI API key
OPENAI_API_KEY=

# Anthropic API key
ANTHROPIC_API_KEY=

# Google Gemini API key (wins over GOOGLE_API_KEY)
GEMINI_API_KEY=

# Google Gemini API key, used when GEMINI_API_KEY is unset
GOOGLE_API_KEY=

# Cohere API key
COHERE_API_KEY=

# Azure OpenAI API key
AZURE_OPENAI_API_KEY=

# Groq API key
GROQ_API_KEY=

# Mistral AI API key
MISTRAL_API_KEY=

# Together AI API key
TOGETHER_API_KEY=

# Perplexity API key
PERPLEXITY_API_KEY=

# OpenRouter API key
OPENROUTER_API_KEY=

# ===========================================
# Provider settings
# ===========================================

# Ollama host
# OLLAMA_HOST=127.0.0.1

# Ollama port
# OLLAMA_PORT=11434

# Azure OpenAI resource name (an x-azure-resource header wins)
# AZURE_OPENAI_RESOURCE=your-resource-name

# Azure OpenAI API version
# AZURE_OPENAI_API_VERSION=2024-02-01

# Azure deployment for a model; <MODEL> is the model name uppercased with . and - as _
# e.g. AZURE_DEPLOYMENT_GPT_35_TURBO=gpt-35-turbo-deployment

# Helicone gateway host
# HELICONE_HOST=oai.helicone.ai

# Helicone gateway port
# HELICONE_PORT=443

# Helicone key used when the request has no helicone-auth header
# HELICONE_API_KEY=

# ===========================================
# OTLP export
# ===========================================
# Forward stored traces, logs and metrics to another OTLP/HTTP backend
# (Jaeger, Grafana Tempo, Langfuse, Phoenix, Opik, ...).

# Enable export (true); setting any endpoint enables it too
# OTLP_EXPORT_ENABLED=false

# Full traces URL
# OTLP_EXPORT_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Alias for the traces URL; it does not enable logs or metrics
# OTLP_EXPORT_ENDPOINT=http://localhost:4318/v1/traces

# Full logs URL; logs are exported only when set
# OTLP_EXPORT_LOGS_ENDPOINT=http://localhost:4318/v1/logs

# Full metrics URL; metrics are exported only when set
# OTLP_EXPORT_METRICS_ENDPOINT=http://localhost:4318/v1/metrics

# http/json or http/protobuf (Phoenix accepts protobuf only)
# OTLP_EXPORT_PROTOCOL=http/json

# Headers sent with every export (comma-separated key=value)
# Langfuse: Authorization=Basic base64(pk:sk)
# Phoenix: space_id=xxx,api_key=xxx
# Opik: Authorization=your-api-key,projectName=your-project
# OTLP_EXPORT_HEADERS=Authorization=Bearer xxx,X-Custom-Header=value

# Records per export batch, per signal
# OTLP_EXPORT_BATCH_SIZE=100

# Milliseconds between flushes
# OTLP_EXPORT_FLUSH_INTERVAL_MS=5000

# Also export the deprecated v1.36.0 GenAI attribute names (1=on)
# LLMFLOW_OTLP_LEGACY_ATTRS=0

# ===========================================
# Development
# ===========================================
# Used by bun run dev, bun run demo and the build scripts.

# Backend the dashboard dev server and demo target (default: the running dev backend)
# LLMFLOW_URL=http://127.0.0.1:1337

# Where dev servers record their URLs (default: a per-checkout temp directory)
# LLMFLOW_DEV_STATE_DIR=/tmp/llmflow-dev

# Dashboard dev server port
# VITE_PORT=5173

# Dashboard dev server bind interface
# VITE_HOST=127.0.0.1

# Reuse an existing apps/server/dist instead of rebuilding (1=on; CI)
# LLMFLOW_REUSE_BUILD=0
