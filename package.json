{
  "name": "llmflow-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.13",
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e/*"
  ],
  "catalog": {
    "@playwright/test": "^1.60.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "start": "bun run --filter llmflow start",
    "start:verbose": "bun run --filter llmflow start:verbose",
    "dev": "bun run --parallel --filter llmflow --filter @llmflow/dashboard dev",
    "dev:server": "bun run --filter llmflow dev",
    "dev:dashboard": "bun run --filter @llmflow/dashboard dev",
    "dev:status": "bun run --filter llmflow status",
    "build": "bun run --filter llmflow build",
    "demo": "bun run --filter llmflow demo",
    "demo:many": "bun run --filter llmflow demo:many",
    "test": "bun run test:server && bun run test:dashboard",
    "test:server": "bun test --isolate --path-ignore-patterns='**/live/**' apps/server packages",
    "test:dashboard": "bun run --filter @llmflow/dashboard test",
    "test:live": "bun test --isolate apps/server/test/live",
    "test:e2e": "bunx playwright test",
    "test:e2e:headed": "bunx playwright test --headed",
    "test:e2e:ui": "bunx playwright test --ui",
    "typecheck": "bun run --filter '*' typecheck && bunx tsc --noEmit -p scripts/tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "test:package": "bun run scripts/test-package.ts"
  },
  "devDependencies": {
    "@llmflow/shared": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/bun": "^1.3.14",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "catalog:"
  }
}
