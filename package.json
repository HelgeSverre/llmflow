{
  "name": "llmflow",
  "version": "0.4.1",
  "description": "See what your LLM calls cost. One command. No signup.",
  "private": false,
  "type": "module",
  "bin": {
    "llmflow": "./bin/llmflow.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e/*",
    "website"
  ],
  "scripts": {
    "start": "bun bin/llmflow.js",
    "start:verbose": "bun bin/llmflow.js --verbose",
    "dev": "bun --watch scripts/dev.ts all",
    "dev:server": "bun --watch scripts/dev.ts server",
    "dev:dashboard": "bun scripts/dev.ts dashboard",
    "build": "bun scripts/build.ts",
    "demo": "bun scripts/dev.ts demo",
    "demo:many": "bun scripts/dev.ts demo --count=20",
    "test": "bun run --filter @llmflow/server test",
    "test:otlp": "bun run --filter @llmflow/server test:otlp",
    "test:ws": "bun run --filter @llmflow/server test:ws",
    "test:logs": "bun run --filter @llmflow/server test:logs",
    "test:metrics": "bun run --filter @llmflow/server test:metrics",
    "test:providers": "bun run --filter @llmflow/server test:providers",
    "test:providers-e2e": "bun run --filter @llmflow/server test:providers-e2e",
    "test:e2e": "bunx playwright test",
    "test:e2e:headed": "bunx playwright test --headed",
    "test:e2e:ui": "bunx playwright test --ui",
    "typecheck": "bun run --filter '*' typecheck && bunx tsc --noEmit -p scripts/tsconfig.json",
    "test:package": "bun run scripts/test-package.ts",
    "prepack": "bun run build"
  },
  "files": [
    "bin/",
    "dist/"
  ],
  "keywords": [
    "llm",
    "observability",
    "tracing",
    "opentelemetry"
  ],
  "author": "Helge Sverre",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HelgeSverre/llmflow"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/bun": "^1.3.14",
    "bun-types": "^1.3.14",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.2",
    "typescript": "^6.0.3"
  }
}
