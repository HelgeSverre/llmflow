{
  "name": "llmflow",
  "version": "0.4.1",
  "description": "See what your LLM calls cost. One command. No signup.",
  "type": "module",
  "bin": {
    "llmflow": "./bin/llmflow.js"
  },
  "files": [
    "bin/",
    "dist/"
  ],
  "scripts": {
    "start": "bun src/server.ts",
    "start:verbose": "bun src/server.ts --verbose",
    "dev": "bun --watch scripts/dev.ts server",
    "demo": "bun scripts/dev.ts demo",
    "demo:many": "bun scripts/dev.ts demo --count=20",
    "status": "bun scripts/dev.ts status",
    "build": "bun scripts/build.ts",
    "prepack": "bun run build && cp ../../README.md ../../LICENSE .",
    "postpack": "rm -f README.md LICENSE",
    "test": "bun run test/run-tests.js",
    "test:otlp": "bun run test/run-tests.js otlp-e2e.js",
    "test:ws": "bun run test/run-tests.js websocket-e2e.js",
    "test:logs": "bun run test/run-tests.js otlp-logs-e2e.js",
    "test:metrics": "bun run test/run-tests.js otlp-metrics-e2e.js",
    "test:providers": "bun run test/run-tests.js providers.js",
    "test:providers-e2e": "bun run test/run-tests.js providers-e2e.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "llm",
    "observability",
    "tracing",
    "opentelemetry"
  ],
  "author": "Helge Sverre",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelgeSverre/llmflow.git",
    "directory": "apps/server"
  },
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=18"
  },
  "devDependencies": {
    "@llmflow/dashboard": "workspace:*",
    "@llmflow/db": "workspace:*",
    "@llmflow/dev-runtime": "workspace:*",
    "@llmflow/otlp": "workspace:*",
    "@llmflow/pricing": "workspace:*",
    "@llmflow/providers": "workspace:*",
    "@llmflow/shared": "workspace:*"
  }
}
