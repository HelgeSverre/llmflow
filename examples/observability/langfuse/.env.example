# LLMFlow settings for forwarding to the local Langfuse started from this directory.
# The Basic credentials are base64("pk-lf-llmflow-local:sk-lf-llmflow-local"), the keys in langfuse.env.
OTLP_EXPORT_TRACES_ENDPOINT=http://127.0.0.1:3000/api/public/otel/v1/traces
OTLP_EXPORT_HEADERS="Authorization=Basic cGstbGYtbGxtZmxvdy1sb2NhbDpzay1sZi1sbG1mbG93LWxvY2Fs"
OTLP_EXPORT_BATCH_SIZE=50
OTLP_EXPORT_FLUSH_INTERVAL_MS=2000
