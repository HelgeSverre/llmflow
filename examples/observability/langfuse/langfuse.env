# Headless initialisation for Langfuse's own docker-compose.yml: creates an organisation, a
# project with the API keys below and a login, so no setup in the UI is needed. Local use only.
LANGFUSE_INIT_ORG_ID=llmflow
LANGFUSE_INIT_ORG_NAME=LLMFlow
LANGFUSE_INIT_PROJECT_ID=llmflow
LANGFUSE_INIT_PROJECT_NAME=LLMFlow
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-llmflow-local
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-llmflow-local
LANGFUSE_INIT_USER_EMAIL=admin@llmflow.local
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=llmflow-local
