# Phoenix (Arize) OTLP Export Configuration

# Local Phoenix instance
OTLP_EXPORT_ENDPOINT=http://localhost:6006/v1/traces

# Phoenix accepts OTLP protobuf only (JSON gets 415 Unsupported Media Type)
OTLP_EXPORT_PROTOCOL=http/protobuf

# For Arize Cloud (app.phoenix.arize.com):
# OTLP_EXPORT_ENDPOINT=https://app.phoenix.arize.com/v1/traces
# OTLP_EXPORT_HEADERS=api_key=your-api-key

# Optional: batch settings
OTLP_EXPORT_BATCH_SIZE=50
OTLP_EXPORT_FLUSH_INTERVAL_MS=2000
