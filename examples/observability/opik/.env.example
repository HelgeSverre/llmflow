# LLMFlow settings for exporting to a local Opik started with ./opik.sh (see README.md).
OTLP_EXPORT_TRACES_ENDPOINT=http://127.0.0.1:5173/api/v1/private/otel/v1/traces
# Selects the Opik project; it is created on the first span.
OTLP_EXPORT_HEADERS=projectName=llmflow
OTLP_EXPORT_BATCH_SIZE=50
OTLP_EXPORT_FLUSH_INTERVAL_MS=2000

# Comet-hosted Opik instead (not checked against LLMFlow; see Opik's OpenTelemetry docs):
# OTLP_EXPORT_TRACES_ENDPOINT=https://www.comet.com/opik/api/v1/private/otel/v1/traces
# OTLP_EXPORT_HEADERS=Authorization=<api-key>,Comet-Workspace=<workspace>,projectName=llmflow
